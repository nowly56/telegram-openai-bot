# Получите токен у @BotFather в Telegram.
TELEGRAM_BOT_TOKEN=

# Создайте API-ключ на https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Можно заменить на другую доступную модель.
OPENAI_MODEL=gpt-5.6-sol

# В группе бот отвечает на это имя.
BOT_NAME=Роберт

# Полная история чатов сохраняется здесь.
CONTEXT_FILE=data/chat-context.json

# Необязательно: задайте характер и правила бота.
BOT_SYSTEM_PROMPT=Ты дружелюбный помощник в Telegram-группе. Отвечай по-русски, если пользователь не попросил другой язык. Пиши ясно и по делу.

# Вместо длинного промпта можно указать отдельный файл.
BOT_SYSTEM_PROMPT_FILE=bot_prompt.txt
